# Database
DATABASE_URL=postgresql://tracker:your_password_here@localhost:5433/claude_token_tracker
POSTGRES_PASSWORD=your_password_here
# Pool size (default 10). Aumentar se muitos clients concorrentes.
# DB_POOL_MAX=10

# Server
PORT=3002
NODE_ENV=development  # production em deploy

# Comma-separated lista de origins permitidos pelo CORS.
# Default (se vazio): http://localhost:3002,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:3002,http://localhost:5173

# Auth
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
# Bcrypt cost factor (10-14). Default 12. Maior = mais seguro mas slower.
# BCRYPT_COST=12

# Bootstrap
# SECURITY: bootstrap gate for first-user-becomes-super_admin flow.
# Apenas o email listado aqui pode virar super_admin no primeiro register.
# Sem isso, primeiro usuário a registrar vira super_admin (UNSAFE em deploy publico).
BOOTSTRAP_SUPER_ADMIN_EMAIL=patrick.studioartemis@gmail.com

# Webhook (default — não-secreto, gerado por user via UI no signup)
# WEBHOOK_TOKEN_DEFAULT=

# Brevo SMTP (transactional emails — password reset, etc.)
# Get credentials in Brevo: Settings → SMTP & API → SMTP tab
# If unset, emailService falls back to console log (dev mode).
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-smtp-login@smtp-brevo.com
# SMTP_PASS=xsmtpsib-...
# SMTP_FROM=Ciato Tech <no-reply@ciatotech.com>
# APP_BASE_URL=http://localhost:3002

# Filesystem sources for /api/skills and /api/system-prompts viewers.
# Defaults (in server/src/config/env.ts) match Patrick's Windows setup.
# Override here if running on a different machine or layout.
# SKILLFORGE_DIR=C:/Users/Patrick Neuhaus/Documents/Github/skillforge-arsenal/skills
# OMC_DIR=C:/Users/Patrick Neuhaus/Documents/Github/oh-my-claudecode/skills
# BUILTIN_CACHE=C:/Users/Patrick Neuhaus/.claude/plugins/cache
# FIXES_FILE=C:/Users/Patrick Neuhaus/Documents/Github/skillforge-arsenal/FIXES-APLICADOS.md
# GITHUB_ROOT_CLAUDE_MD=C:/Users/Patrick Neuhaus/Documents/Github/CLAUDE.md
# SKILLFORGE_CLAUDE_MD=C:/Users/Patrick Neuhaus/Documents/Github/skillforge-arsenal/CLAUDE.md
# OMC_CLAUDE_MD=C:/Users/Patrick Neuhaus/Documents/Github/oh-my-claudecode/CLAUDE.md
# TOKEN_TRACKER_CLAUDE_MD=C:/Users/Patrick Neuhaus/Documents/Github/claude-token-tracker/CLAUDE.md
# CLAUDE_RULES_DIR=C:/Users/Patrick Neuhaus/.claude/rules
